<%
  const homeCover = theme.home_cover || {};
  const homeCoverTitle = homeCover.title || 'RhiannonGrove';
  const homeCoverSubtitle = homeCover.subtitle || '在字里行间，慢慢生长。';
%>

<section class="home-cover">
  <div class="home-stars" aria-hidden="true"></div>
  <div class="home-cover-content">
    <h1><%= homeCoverTitle %></h1>
    <p><%= homeCoverSubtitle %></p>
  </div>
  <a class="home-scroll" href="#latest-title" aria-label="向下查看文章"><span aria-hidden="true"></span></a>
</section>

<%
  const archiveMonths = [];
  const archiveMonthMap = {};
  const chineseMonths = ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'];

  site.posts.sort('-date').each(function(post) {
    const year = date(post.date, 'YYYY');
    const month = date(post.date, 'MM');
    const key = year + '-' + month;

    if (!archiveMonthMap[key]) {
      archiveMonthMap[key] = {
        year: year,
        month: month,
        label: chineseMonths[Number(month) - 1] + ' ' + year,
        count: 0
      };
      archiveMonths.push(archiveMonthMap[key]);
    }

    archiveMonthMap[key].count += 1;
  });
%>

<div class="home-body">
<div class="home-content">
  <section class="post-section" aria-labelledby="latest-title">
    <div class="section-heading">
      <p class="eyebrow">Journal</p>
      <h2 id="latest-title">近期文章</h2>
    </div>
    <% if (page.posts.length) { %>
      <div class="post-list">
        <% page.posts.each(function(post) { %>
          <article class="post-card">
            <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY · MM · DD') %></time>
            <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
            <span class="post-arrow" aria-hidden="true">↗</span>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p class="empty-note">文章即将到来。</p>
    <% } %>
  </section>

  <aside class="home-sidebar" aria-label="文章导航">
    <section class="tag-widget" id="tags" aria-labelledby="sidebar-tags-title">
      <h2 class="sidebar-widget-title" id="sidebar-tags-title">
        <span aria-hidden="true">#</span> 分类标签
      </h2>
      <% if (site.tags && site.tags.length) { %>
        <ul class="sidebar-tag-list">
          <% site.tags.sort('name').each(function(tag) { %>
            <li>
              <a href="<%- url_for(tag.path) %>">
                <span># <%= tag.name %></span>
                <em><%= tag.length %></em>
              </a>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="empty-note">暂无标签。</p>
      <% } %>
    </section>

    <section class="archive-widget">
      <h2 class="sidebar-widget-title">
        <a href="<%- url_for('/archives/') %>"><span aria-hidden="true">▣</span> 归档</a>
      </h2>
      <% if (archiveMonths.length) { %>
        <ul class="archive-month-list">
          <% archiveMonths.forEach(function(item) { %>
            <li>
              <a href="<%- url_for('/archives/' + item.year + '/' + item.month + '/') %>">
                <span><%= item.label %></span>
                <em><%= item.count %></em>
              </a>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="empty-note">暂无归档。</p>
      <% } %>
    </section>
    <%
      const siteInfo = grove_site_info();
    %>
    <section class="site-info-widget" aria-labelledby="site-info-title">
      <h2 class="sidebar-widget-title" id="site-info-title">
        <svg class="site-info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3v17h17M8 14l4-5 4 3 5-7"/></svg>
        网站信息
      </h2>
      <dl class="site-info-list">
        <div><dt>文章数目：</dt><dd><%= siteInfo.posts %></dd></div>
        <div><dt>本站总字数：</dt><dd title="<%= siteInfo.words.toLocaleString('zh-CN') %> 字（不含代码块）"><%= siteInfo.wordLabel %></dd></div>
        <div><dt>本站访客数：</dt><dd><span id="busuanzi_value_site_uv" title="访问统计加载中" aria-live="polite">—</span></dd></div>
        <div><dt>本站总浏览量：</dt><dd><span id="busuanzi_value_site_pv" title="访问统计加载中" aria-live="polite">—</span></dd></div>
        <div><dt>最后更新时间：</dt><dd><% if (siteInfo.updated) { %><time class="site-info-updated" datetime="<%= siteInfo.updated %>" title="<%= date(siteInfo.updated, 'YYYY-MM-DD HH:mm') %>"><%= date(siteInfo.updated, 'YYYY-MM-DD') %></time><% } else { %>—<% } %></dd></div>
      </dl>
    </section>
  </aside>
</div>
</div>
