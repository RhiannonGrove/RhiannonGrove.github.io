<section class="article archive-page tag-page">
  <a class="back-link" href="<%- url_for('/#tags') %>">← 返回标签</a>
  <p class="eyebrow">Tag</p>
  <h1># <%= page.tag %></h1>
  <p class="archive-summary">共 <%= page.posts.length %> 篇文章</p>
  <% if (page.posts.length) { %>
    <div class="post-list">
      <% page.posts.each(function(post) { %>
        <article class="post-card">
          <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY · MM · DD') %></time>
          <h2><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
          <span class="post-arrow" aria-hidden="true">↗</span>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <p class="empty-note">这个标签下暂时没有文章。</p>
  <% } %>
</section>
