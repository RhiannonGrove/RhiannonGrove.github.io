<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= config.description %>">
  <title><%= page.title ? page.title + ' · ' + config.title : config.title %></title>
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
</head>
<body>
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href="<%- url_for('/') %>">Rhiannon<span> Grove</span></a>
      <nav aria-label="主导航">
        <a href="<%- url_for('/') %>">首页</a>
        <a href="<%- url_for('/archives/') %>">归档</a>
        <a href="<%- url_for('/about/') %>">关于</a>
      </nav>
    </header>
    <main><%- body %></main>
    <footer class="site-footer">
      <span>© <%= new Date().getFullYear() %> Rhiannon Grove</span>
      <span>写给时间，也写给自己。</span>
    </footer>
  </div>
</body>
</html>
