<%
  const configuredHomeCover = theme.home_cover || {};
  const configuredHomeCoverImage = configuredHomeCover.image || '/images/home-cover.jpg';
  const hasBackgroundVideo = Boolean(configuredHomeCover.video);
  const defaultBackgroundMode = configuredHomeCover.type === 'video' && hasBackgroundVideo ? 'video' : 'image';
%>
<!doctype html>
<html lang="zh-CN" data-visual-theme="original" data-background-default="<%= defaultBackgroundMode %>" data-background-mode="<%= defaultBackgroundMode %>" data-has-video="<%= hasBackgroundVideo %>" data-card-opacity-defaults="<%= JSON.stringify(theme.card_opacity || {}) %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= config.description %>">
  <title><%= page.title ? page.title + ' · ' + config.title : config.title %></title>
  <script src="<%- url_for('/js/theme-preload.js') %>?v=20261022-card-opacity"></script>
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>?v=20261021-video-background">
  <link rel="stylesheet" href="<%- url_for('/css/visual-themes.css') %>?v=20261022-card-opacity">
  <script src="<%- url_for('/js/theme-switcher.js') %>?v=20261022-card-opacity" defer></script>
  <script src="<%- url_for('/js/background.js') %>?v=20261021-appearance" defer></script>
  <script src="<%- url_for('/js/code-blocks.js') %>?v=20261020-text-copy" defer></script>
  <script src="<%- url_for('/js/home-stars.js') %>?v=20261020-fixed-bg-nav" defer></script>
  <script src="<%- url_for('/js/site-info.js') %>?v=20261021-site-info" data-site-url="<%= config.url %>" defer></script>
</head>
<body class="<%= is_home() ? 'home-page image-background' : 'image-background' %>" style="--home-cover-image: url(<%= JSON.stringify(url_for(configuredHomeCoverImage)) %>);">
  <% if (hasBackgroundVideo) { %>
    <video class="site-background-video" data-src="<%= url_for(configuredHomeCover.video) %>" poster="<%= url_for(configuredHomeCoverImage) %>" autoplay muted loop playsinline preload="none" disablepictureinpicture disableremoteplayback aria-hidden="true" tabindex="-1"></video>
  <% } %>
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href="<%- url_for('/') %>">Rhiannon<span> Grove</span></a>
      <nav aria-label="主导航">
        <a href="<%- url_for('/') %>">首页</a>
        <a href="<%- url_for('/#tags') %>">标签</a>
        <a href="<%- url_for('/archives/') %>">归档</a>
        <a href="<%- url_for('/about/') %>">关于</a>
      </nav>
    </header>
    <main><%- body %></main>
    <footer class="site-footer">
      <span>© <%= new Date().getFullYear() %> Rhiannon Grove</span>
      <span>写给时间，也写给自己。</span>
    </footer>
  </div>
</body>
</html>
