<%
  const articleToc = toc(page.content, { list_number: false });
  const hasToc = articleToc.includes('<li');
%>

<div class="reading-layout<%= hasToc ? '' : ' no-toc' %>">
  <article class="article">
    <a class="back-link" href="<%- url_for('/') %>">← 返回首页</a>
    <header class="article-header">
      <p class="eyebrow">Journal · <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY · MM · DD') %></time></p>
      <h1><%= page.title %></h1>
    </header>
    <div class="prose"><%- page.content %></div>
  </article>

  <% if (hasToc) { %>
    <aside class="article-toc" aria-label="文章目录">
      <div class="toc-card">
        <p class="toc-title">☰&nbsp; 目录</p>
        <%- articleToc %>
      </div>
    </aside>
  <% } %>
</div>
