<%
  const articleToc = toc(page.content, { list_number: false });
  const hasToc = articleToc.includes('<li');
  const articleUpdated = page.updated || page.date;
%>

<div class="reading-layout<%= hasToc ? '' : ' no-toc' %>">
  <article class="article">
    <a class="back-link" href="<%- url_for('/') %>">← 返回首页</a>
    <header class="article-header">
      <p class="eyebrow">Journal</p>
      <h1><%= page.title %></h1>
      <p class="article-meta">
        <span class="article-meta-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2v3M17 2v3M3.5 9h17M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm3 9h2m4 0h2m-8 4h2m4 0h2"/></svg>
          发表于 <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
        </span>
        <span class="article-meta-divider" aria-hidden="true">|</span>
        <span class="article-meta-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4v5h5M4.7 9A8 8 0 1 1 4 14m8-6v5l3 2"/></svg>
          更新于 <time datetime="<%= date(articleUpdated, 'YYYY-MM-DD') %>"><%= date(articleUpdated, 'YYYY-MM-DD') %></time>
        </span>
      </p>
      <% if (page.tags && page.tags.length) { %>
        <div class="article-tags" aria-label="文章标签">
          <% page.tags.each(function(tag) { %>
            <a class="article-tag" href="<%- url_for(tag.path) %>"># <%= tag.name %></a>
          <% }) %>
        </div>
      <% } %>
    </header>
    <div class="prose"><%- page.content %></div>
  </article>

  <% if (hasToc) { %>
    <aside class="article-toc" aria-label="文章目录">
      <div class="toc-card">
        <p class="toc-title">☰&nbsp; 目录</p>
        <%- articleToc %>
      </div>
    </aside>
  <% } %>
</div>

